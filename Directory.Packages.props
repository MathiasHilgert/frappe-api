<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
    <DotNetVersion>11.0.0</DotNetVersion>
    <!-- Npgsql.EntityFrameworkCore.PostgreSQL 11.0.0 GA is not on NuGet yet (checked 2026-11-13), and 11.0.0-rc.3 pins
         EF Core to exactly 11.0.0-rc.3.26522.148. EF Core (and dotnet-ef in .config/dotnet-tools.json) stays on that build until
         the provider ships; then EfCoreVersion and NpgsqlEfVersion move to 11.0.0 together. -->
    <EfCoreVersion>11.0.0-rc.3.26522.148</EfCoreVersion>
    <NpgsqlEfVersion>11.0.0-rc.3</NpgsqlEfVersion>
    <OpenTelemetryVersion>1.20.1</OpenTelemetryVersion>
    <FusionCacheVersion>2.9.0</FusionCacheVersion>
    <TestcontainersVersion>4.16.0</TestcontainersVersion>
  </PropertyGroup>
  <ItemGroup Label="Microsoft">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="$(DotNetVersion)" />
    <PackageVersion Include="Microsoft.AspNetCore.TestHost" Version="$(DotNetVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="$(EfCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="$(EfCoreVersion)" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="$(EfCoreVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="$(DotNetVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks" Version="$(DotNetVersion)" />
    <!-- Transitive through EF Core rc.3 (a ">=" range); pinned here so only EF Core itself stays on the release candidate. -->
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="$(DotNetVersion)" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="$(DotNetVersion)" />
    <PackageVersion Include="Microsoft.Extensions.DependencyModel" Version="$(DotNetVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Logging" Version="$(DotNetVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="$(DotNetVersion)" />
    <!-- Ships on its own cadence (dotnet/extensions), not with the runtime; 11.0.0 is its first release for .NET 11. -->
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="11.0.0" />
  </ItemGroup>
  <ItemGroup Label="Persistence">
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="$(NpgsqlEfVersion)" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL.NodaTime" Version="$(NpgsqlEfVersion)" />
    <!-- Follows the Npgsql driver (10.0.3), which is what Npgsql.EntityFrameworkCore.PostgreSQL 11.0.0-rc.3 depends on. -->
    <PackageVersion Include="Npgsql" Version="10.0.3" />
    <PackageVersion Include="Npgsql.OpenTelemetry" Version="10.0.3" />
    <PackageVersion Include="MessageFormat" Version="8.0.0" />
    <PackageVersion Include="NodaTime" Version="3.3.7" />
    <PackageVersion Include="NodaTime.Serialization.SystemTextJson" Version="1.4.0" />
  </ItemGroup>
  <ItemGroup Label="Messaging and scheduling">
    <PackageVersion Include="NATS.Net" Version="3.3.2" />
    <PackageVersion Include="Quartz.Extensions.Hosting" Version="4.7.2" />
  </ItemGroup>
  <ItemGroup Label="Caching">
    <PackageVersion Include="ZiggyCreatures.FusionCache" Version="$(FusionCacheVersion)" />
    <PackageVersion Include="ZiggyCreatures.FusionCache.Backplane.StackExchangeRedis" Version="$(FusionCacheVersion)" />
    <PackageVersion Include="ZiggyCreatures.FusionCache.Serialization.SystemTextJson" Version="$(FusionCacheVersion)" />
    <PackageVersion Include="ZiggyCreatures.FusionCache.OpenTelemetry" Version="$(FusionCacheVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="$(DotNetVersion)" />
  </ItemGroup>
  <ItemGroup Label="Observability">
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="OpenTelemetry.Exporter.InMemory" Version="$(OpenTelemetryVersion)" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.2" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.1" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Process" Version="1.20.1-rc.1" />
  </ItemGroup>
  <ItemGroup Label="Web">
    <PackageVersion Include="Scalar.AspNetCore" Version="2.19.0" />
  </ItemGroup>
  <ItemGroup Label="Testing">
    <PackageVersion Include="TUnit" Version="1.81.10" />
    <PackageVersion Include="NetArchTest.Rules" Version="1.3.2" />
    <PackageVersion Include="Testcontainers" Version="$(TestcontainersVersion)" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="$(TestcontainersVersion)" />
    <PackageVersion Include="Testcontainers.Redis" Version="$(TestcontainersVersion)" />
  </ItemGroup>
  <ItemGroup Label="Analyzers">
    <!-- Only SA1402/SA1649 (one type per file, named after it) are enabled, in .editorconfig. StyleCop has had no stable
         release since 1.1.118, which predates modern C#; 1.2.0-beta.556 is the build the .NET community pins. Bump it
         deliberately, since it is a prerelease. -->
    <PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.556" />
    <!-- Sonar's community analyzer: its default rules and cognitive complexity (S3776), without a SonarQube server. -->
    <PackageVersion Include="SonarAnalyzer.CSharp" Version="10.35.0.4138" />
  </ItemGroup>
</Project>
