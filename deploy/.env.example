# Copy to deploy/.env and choose your own values: `cp deploy/.env.example deploy/.env`. .env is ignored by git.
# docker compose (-f deploy/compose.yaml) and just both read it from there.
# Every variable without a default is required: docker compose refuses to start when one is missing.

# Postgres owner: used only by the Migrator (DDL).
POSTGRES_OWNER_USER=frappe_owner
POSTGRES_OWNER_PASSWORD=

# Module roles, created by the Migrator with data-only access to their own schema.
FRAPPE_GEO_PASSWORD=
FRAPPE_SCHEDULER_PASSWORD=

# Grafana admin (http://localhost:3000).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Host ports (optional): the defaults below are used when a line is missing; change one if it is taken.
# API_PORT=8080
# GRAFANA_PORT=3000
# POSTGRES_PORT=5432
# NATS_PORT=4222
# NATS_MONITOR_PORT=8222
# VALKEY_PORT=6379
# OTLP_GRPC_PORT=4317
# OTLP_HTTP_PORT=4318
# LOKI_PORT=3100
# TEMPO_PORT=3200
# MIMIR_PORT=9009

