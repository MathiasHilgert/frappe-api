# Local development values: `cp deploy/.env.example deploy/.env`. The copy, .env, is ignored by git.
# docker compose (-f deploy/compose.yaml) and just both read it from there.
#
# EVERY VALUE BELOW IS A PLACEHOLDER FOR YOUR OWN MACHINE. Postgres, the Api and Grafana publish their ports on every interface (the services
# without authentication, such as Valkey, NATS, OTLP, Loki, Tempo and Mimir, only on 127.0.0.1), so on a shared
# network choose your own values (`openssl rand -hex 16`) before `just stack up`. Never reuse them anywhere else, and never put a
# real secret in this file: it is committed. Every variable without a default is required: docker compose refuses to start when
# one is missing.

# Postgres owner: used only by the Migrator (DDL).
POSTGRES_OWNER_USER=frappe_owner
POSTGRES_OWNER_PASSWORD=local-only-owner-password

# Login roles the Migrator creates, with data-only access to their own schema. The Worker's scheduler role owns Quartz's job store.
# A module adds its own FRAPPE_<MODULE>_PASSWORD here.
FRAPPE_SCHEDULER_PASSWORD=local-only-scheduler-password

# Console origins (optional): the browsers allowed to call the API with the session cookie (Http:Console:Origins),
# comma separated. Defaults to http://localhost:5173 when the line is missing.
# FRAPPE_CONSOLE_ORIGINS=http://localhost:5173
# Requests one client address may make per minute before 429 (Http:RateLimit:PermitLimit).
# FRAPPE_HTTP_RATE_LIMIT=120

# Grafana admin (http://localhost:3000).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local-only-grafana-password

# Host ports (optional): the defaults below are used when a line is missing; change one if it is taken.
# API_PORT=8080
# GRAFANA_PORT=3000
# POSTGRES_PORT=5432
# NATS_PORT=4222
# NATS_MONITOR_PORT=8222
# VALKEY_PORT=6379
# OTLP_GRPC_PORT=4317
# OTLP_HTTP_PORT=4318
# LOKI_PORT=3100
# TEMPO_PORT=3200
# MIMIR_PORT=9009
