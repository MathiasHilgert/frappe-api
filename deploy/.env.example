# Local development values: `cp deploy/.env.example deploy/.env`. The copy, .env, is ignored by git.
# docker compose (-f deploy/compose.yaml) and just both read it from there.
#
# EVERY VALUE BELOW IS A PLACEHOLDER FOR YOUR OWN MACHINE. Postgres, the Api and Grafana publish their ports on every interface (the services
# without authentication, such as Valkey, NATS, OTLP, Loki, Tempo and Mimir, only on 127.0.0.1), so on a shared
# network choose your own values (`openssl rand -hex 16`) before `just stack up`. Never reuse them anywhere else, and never put a
# real secret in this file: it is committed. Every variable without a default is required: docker compose refuses to start when
# one is missing.

# Postgres owner: used only by the Migrator (DDL).
POSTGRES_OWNER_USER=frappe_owner
POSTGRES_OWNER_PASSWORD=local-only-owner-password

# Login roles the Migrator creates, with data-only access to their own schema. The Worker's scheduler role owns Quartz's job store.
# A module adds its own FRAPPE_<MODULE>_PASSWORD here.
FRAPPE_SCHEDULER_PASSWORD=local-only-scheduler-password
FRAPPE_NOTIFICATIONS_PASSWORD=local-only-notifications-password
FRAPPE_NOTIFICATIONS_WORKER_PASSWORD=local-only-notifications-worker-password

# The key addresses are hashed with (Notifications:AddressHash:Keys:1): base64 of at least 32 bytes. This value is a placeholder for your own
# machine; for anything shared generate one with `openssl rand -base64 32`.
FRAPPE_NOTIFICATIONS_ADDRESS_HASH_KEY=bG9jYWwtb25seS1hZGRyZXNzLWhhc2gta2V5LW9mLTM5LWJ5dGVz

# The key unsubscribe links are signed with (Notifications:Unsubscribe:SigningKey): base64 of at least 32 bytes, the same for the Api and the
# Worker. Tokens never expire, so changing it breaks links already mailed (a rotation keeps the old key as a retired one). This value is a
# placeholder for your own machine; for anything shared generate one with `openssl rand -base64 32`.
FRAPPE_NOTIFICATIONS_UNSUBSCRIBE_KEY=bG9jYWwtb25seS11bnN1YnNjcmliZS1zaWduaW5nLWtleSEh
# Rotating that key (see docs/notifications-key-rotation.md): put the new key above, set Notifications__Unsubscribe__CurrentKeyId=2 and move the
# old one to Notifications__Unsubscribe__RetiredKeys__1=<the old key> in your own deploy/.env, so links already mailed keep verifying.
# The frontend page the visible unsubscribe link of a marketing email opens (Notifications:Unsubscribe:PageUrl); the page does not exist yet.
FRAPPE_NOTIFICATIONS_UNSUBSCRIBE_PAGE_URL=http://localhost:5173/unsubscribe
# Where mail clients reach this API for the one-click unsubscribe (Notifications:Unsubscribe:ApiBaseUrl): an http(s) URL ending in a slash.
FRAPPE_NOTIFICATIONS_API_URL=http://localhost:8080/

# The signing secret of Resend's webhook (Notifications:Email:Resend:WebhookSecret): what the Api verifies each call with. Resend shows it
# as `whsec_` plus base64 (with or without the prefix is accepted). This value is a placeholder for your own machine; for anything shared
# copy the secret of the webhook endpoint you create in Resend into your own deploy/.env.
FRAPPE_NOTIFICATIONS_WEBHOOK_SECRET=bG9jYWwtb25seS1yZXNlbmQtd2ViaG9vay1zaWduaW5nLXNlY3JldCEh

# Emails (optional): by default the Worker only logs them (Notifications:Email:Sender=Logging). To send through Resend, add the two lines below
# to your own deploy/.env, never to this file: the key is a secret.
# Notifications__Email__Sender=Resend
# Notifications__Email__Resend__ApiKey=<your Resend API key>

# Console origins (optional): the browsers allowed to call the API with the session cookie (Http:Console:Origins),
# comma separated. Defaults to http://localhost:5173 when the line is missing.
# FRAPPE_CONSOLE_ORIGINS=http://localhost:5173
# Requests one client address may make per minute before 429 (Http:RateLimit:PermitLimit).
# FRAPPE_HTTP_RATE_LIMIT=120

# Grafana admin (http://localhost:3000).
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=local-only-grafana-password

# Host ports (optional): the defaults below are used when a line is missing; change one if it is taken.
# API_PORT=8080
# GRAFANA_PORT=3000
# POSTGRES_PORT=5432
# NATS_PORT=4222
# NATS_MONITOR_PORT=8222
# VALKEY_PORT=6379
# OTLP_GRPC_PORT=4317
# OTLP_HTTP_PORT=4318
# LOKI_PORT=3100
# TEMPO_PORT=3200
# MIMIR_PORT=9009
