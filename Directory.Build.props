<Project>
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Docs are not required on every public member (CS1591), but every cref that exists must resolve. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <InvariantGlobalization>false</InvariantGlobalization>
    <Deterministic>true</Deterministic>
    <!-- Reproducible restores: every project has a packages.lock.json, and CI restores in locked mode. The lock records
         the runtime packs of the image's platforms, so a Docker restore with -a x64|arm64 matches it too. -->
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <RestoreLockedMode Condition="'$(CI)' == 'true'">true</RestoreLockedMode>
    <RuntimeIdentifiers>linux-x64;linux-arm64</RuntimeIdentifiers>
    <!-- Known vulnerabilities in direct and transitive packages are reported on restore. They stay warnings here, so a
         new advisory does not break every local build; the CI check "No vulnerable dependencies" fails on them. -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
    <!-- Meziantou's rules start off; eng/analyzers.globalconfig turns on the ones a convention asks for. -->
    <MeziantouAnalysisMode>None</MeziantouAnalysisMode>
    <!-- Runtime Async (.NET 11): async methods run on the runtime's own suspension and resumption instead of
         compiler-generated state machines, like the .NET libraries themselves. ExecutionContext (and with it
         Activity.Current and every AsyncLocal) still flows across awaits; TraceFlowTests and WorkerHostTests pin that. -->
    <Features>$(Features);runtime-async=on</Features>
  </PropertyGroup>
  <ItemGroup>
    <!-- Error messages per language (ICU MessageFormat), read by Frappe.Http's ErrorMessageCatalog. -->
    <EmbeddedResource Include="Resources/Messages/*.json" LogicalName="frappe.messages/%(Filename)%(Extension)" />
  </ItemGroup>
  <ItemGroup>
    <!-- Analyzer only, never a dependency of what we ship. Its rules are off except where .editorconfig enables them. -->
    <PackageReference Include="StyleCop.Analyzers" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <!-- Analyzer only. Sonar's default rule set plus cognitive complexity (S3776), configured in .editorconfig. -->
    <PackageReference Include="SonarAnalyzer.CSharp" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <!-- Analyzers only. Which of their rules run, and how hard, lives in eng/analyzers.globalconfig. -->
    <PackageReference Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <PackageReference Include="Meziantou.Analyzer" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <PackageReference Include="Roslynator.Analyzers" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
  </ItemGroup>
  <ItemGroup>
    <!-- Thresholds of the code metrics rules (CA1502 cyclomatic complexity). -->
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)eng/CodeMetricsConfig.txt" Link="CodeMetricsConfig.txt" />
    <!-- APIs nobody may call (RS0030), each with the reason and the replacement. -->
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)eng/BannedSymbols.txt" Link="BannedSymbols.txt" />
    <AdditionalFiles Condition="!$([MSBuild]::MakeRelative('$(MSBuildThisFileDirectory)', '$(MSBuildProjectDirectory)').Replace('\','/').StartsWith('tests/'))" Include="$(MSBuildThisFileDirectory)eng/BannedSymbols.Production.txt" Link="BannedSymbols.Production.txt" />
    <!-- Validation in the domain and application layers returns Result (DOM-09); options and host projects use data annotations. -->
    <AdditionalFiles Condition="$(MSBuildProjectName.EndsWith('.Domain')) Or $(MSBuildProjectName.EndsWith('.Application'))" Include="$(MSBuildThisFileDirectory)eng/BannedSymbols.Domain.txt" Link="BannedSymbols.Domain.txt" />
    <!-- A module's Http project answers a Result with ToTypedHttpResult only (HTTP-06); the platform keeps its own uses of ErrorsProblemHttpResult.Of. -->
    <AdditionalFiles Condition="$(MSBuildProjectName.EndsWith('.Http')) And '$(MSBuildProjectName)' != 'Frappe.Http'" Include="$(MSBuildThisFileDirectory)eng/BannedSymbols.Http.txt" Link="BannedSymbols.Http.txt" />
    <GlobalAnalyzerConfigFiles Include="$(MSBuildThisFileDirectory)eng/analyzers.globalconfig" />
  </ItemGroup>
</Project>
