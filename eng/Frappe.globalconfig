is_global = true

# Curated SonarAnalyzer.CSharp profile.
# Only the rules below are enabled; everything else Sonar enables by default is switched off at the
# end of this file, because Sonar categories contain spaces and cannot be targeted by
# dotnet_analyzer_diagnostic.category-*.severity. Re-generate the off list when upgrading Sonar.

# Cognitive complexity at the analyzer default threshold (15).
dotnet_diagnostic.S3776.severity = error
# async void methods.
dotnet_diagnostic.S3168.severity = error
# Commented-out code.
dotnet_diagnostic.S125.severity = error
# TODO tags: visible but non-blocking (WarningsNotAsErrors).
dotnet_diagnostic.S1135.severity = warning
# Repeated literals: visible but non-blocking (WarningsNotAsErrors); excluded paths in .editorconfig.
dotnet_diagnostic.S1192.severity = warning

# StyleCop lives here, not in .editorconfig, because compilation-level diagnostics (SA0001)
# only honor global configs.
# StyleCop runs only member order; every other SA rule is off.
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.DocumentationRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.LayoutRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.MaintainabilityRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.NamingRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.OrderingRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.ReadabilityRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.SpacingRules.severity = none
dotnet_analyzer_diagnostic.category-StyleCop.CSharp.SpecialRules.severity = none
# SA0001 ignores category settings, so it is switched off by ID.
dotnet_diagnostic.SA0001.severity = none
dotnet_diagnostic.SA1201.severity = error
dotnet_diagnostic.SA1202.severity = error
dotnet_diagnostic.SA1203.severity = error
dotnet_diagnostic.SA1204.severity = error

