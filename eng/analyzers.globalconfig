# Which third-party analyzer rules run, and how hard. Each one enforces a frappe-conventions rule (named next to it);
# a rule not listed here stays off. Takes precedence over the packages' own defaults (Meziantou runs in mode None).
is_global = true
global_level = 100

# Roslynator: every rule off unless a convention turns it on below.
roslynator_analyzers.enabled_by_default = false
dotnet_analyzer_diagnostic.category-roslynator.severity = none

# CRAFT-07 · Classes are sealed unless something derives from them: internal ones (CA1852), public ones and
# exceptions (MA0053).
dotnet_diagnostic.CA1852.severity = warning
dotnet_diagnostic.MA0053.severity = warning
MA0053.public_class_should_be_sealed = true
MA0053.exceptions_should_be_sealed = true

# Banned APIs (eng/BannedSymbols*.txt).
dotnet_diagnostic.RS0030.severity = warning

# Frappe.Analyzers (eng/analyzers/Frappe.Analyzers), the repository's own rules.
# SEC-07 · EVT-20 · DOM-06 · A record with a public string member named *Password, *Passphrase, *Secret, *Token,
# *Plaintext or *Email overrides ToString to mask it (FRP001).
dotnet_diagnostic.FRP001.severity = warning
# EVT-21 · PERF-02 · No EF Core EnableRetryOnFailure and no IExecutionStrategy of our own (FRP002).
dotnet_diagnostic.FRP002.severity = warning
# CRAFT-10 · A SuppressMessage has a Justification; a #pragma warning disable has a comment on its line or the one above (FRP003).
dotnet_diagnostic.FRP003.severity = warning
