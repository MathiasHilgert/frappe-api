{
  "$schema": "http://json.schemastore.org/template",
  "author": "Frappe",
  "classifications": ["Frappe", "Scaffold"],
  "identity": "Frappe.Scaffold.Repository",
  "name": "Frappe repository and read port (Application) with their EF Core adapters (Infrastructure)",
  "shortName": "repository",
  "tags": { "language": "C#", "type": "item" },
  "sourceName": "EntityName",
  "preferNameDirectory": false,
  "symbols": {
    "Module": { "type": "parameter", "datatype": "string", "isRequired": true, "replaces": "ModuleName", "fileRename": "ModuleName" },
    "Area": { "type": "parameter", "datatype": "string", "isRequired": true, "replaces": "AreaName", "fileRename": "AreaName", "description": "The plural of the entity: the folder, the namespace and the repository (IOrders, EfOrders)." }
  }
}
