{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-net/master/src/Stryker.Core/Stryker.Core/assets/stryker-config.schema.json",
  "stryker-config": {
    "configuration": "Release",
    "test-runner": "mtp",
    "reporters": ["html", "progress", "markdown"],
    "mutation-level": "Standard",
    "coverage-analysis": "perTest",
    "concurrency": 4,
    "thresholds": {
      "high": 80,
      "low": 60,
      "break": 50
    },
    "ignore-methods": ["*Log*", "ToString", "*Exception.ctor"]
  }
}
