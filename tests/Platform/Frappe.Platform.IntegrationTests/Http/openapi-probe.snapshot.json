{
  "openapi": "3.1.1",
  "info": {
    "title": "Frappe.Platform.IntegrationTests | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost/"
    }
  ],
  "paths": {
    "/v1/probes/problems/{kind}": {
      "get": {
        "tags": [
          "probe"
        ],
        "summary": "Fails with the problem of the given kind.",
        "operationId": "GetProblem",
        "parameters": [
          {
            "name": "kind",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "No Content"
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/probes/echoes": {
      "post": {
        "tags": [
          "probe"
        ],
        "summary": "Answers the request with every wire form.",
        "operationId": "CreateEcho",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EchoRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EchoResponse"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/probes/things/{thingId}": {
      "get": {
        "tags": [
          "probe"
        ],
        "summary": "Answers a thing by its id.",
        "operationId": "GetThing",
        "parameters": [
          {
            "name": "thingId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          }
        }
      }
    },
    "/v1/probes/uploads": {
      "post": {
        "tags": [
          "probe"
        ],
        "summary": "Accepts a body of at most 64 bytes.",
        "operationId": "CreateUpload",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EchoRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/EchoResponse"
                }
              }
            }
          }
        }
      }
    },
    "/v1/probes/failures": {
      "get": {
        "tags": [
          "probe"
        ],
        "summary": "Throws.",
        "operationId": "GetFailure",
        "responses": {
          "200": {
            "description": "OK"
          }
        }
      }
    },
    "/v1/probes/waits": {
      "get": {
        "tags": [
          "probe"
        ],
        "summary": "Waits until the request is cancelled.",
        "operationId": "GetWait",
        "responses": {
          "204": {
            "description": "No Content"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CountryCode": {
        "pattern": "^[A-Z]{2}$",
        "type": "string",
        "description": "An ISO 3166-1 alpha-2 country code in upper case, such as `AR`."
      },
      "EchoColor": {
        "enum": [
          "dark_red"
        ],
        "type": "string"
      },
      "EchoRequest": {
        "required": [
          "name",
          "count"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "null",
              "string"
            ]
          },
          "count": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          }
        },
        "additionalProperties": false
      },
      "EchoResponse": {
        "required": [
          "name",
          "countryCode",
          "date",
          "color",
          "note"
        ],
        "type": "object",
        "properties": {
          "name": {
            "type": [
              "null",
              "string"
            ]
          },
          "countryCode": {
            "$ref": "#/components/schemas/CountryCode"
          },
          "date": {
            "$ref": "#/components/schemas/LocalDate"
          },
          "color": {
            "$ref": "#/components/schemas/EchoColor"
          },
          "note": {
            "type": [
              "null",
              "string"
            ]
          }
        },
        "additionalProperties": false
      },
      "LocalDate": {
        "type": "string",
        "format": "date"
      },
      "ProblemDetails": {
        "type": "object",
        "properties": {
          "type": {
            "type": [
              "null",
              "string"
            ],
            "description": "The stable URN of the problem category, such as urn:frappe:problem:validation."
          },
          "title": {
            "type": [
              "null",
              "string"
            ],
            "description": "The fixed English title of the problem type."
          },
          "status": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "description": "The HTTP status code.",
            "format": "int32"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ],
            "description": "Not used; each entry of errors carries its own localized detail."
          },
          "instance": {
            "type": [
              "null",
              "string"
            ],
            "description": "The request path."
          }
        },
        "additionalProperties": false
      }
    }
  },
  "tags": [
    {
      "name": "probe"
    }
  ]
}
