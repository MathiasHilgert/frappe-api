{
  "openapi": "3.1.1",
  "info": {
    "title": "Frappe.Host | v1",
    "version": "1.0.0"
  },
  "servers": [
    {
      "url": "http://localhost/"
    }
  ],
  "paths": {
    "/v1/geo/time-zones": {
      "get": {
        "tags": [
          "geo"
        ],
        "summary": "Lists the IANA time zones a branch can run in, optionally of one country.",
        "operationId": "ListTimeZones",
        "parameters": [
          {
            "name": "countryCode",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageResponseOfTimeZoneDto"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/geo/currencies": {
      "get": {
        "tags": [
          "geo"
        ],
        "summary": "Lists the ISO 4217 currencies in use, by their name in the requested locale.",
        "operationId": "ListCurrencies",
        "parameters": [
          {
            "name": "locale",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageResponseOfCurrencyDto"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/geo/countries": {
      "get": {
        "tags": [
          "geo"
        ],
        "summary": "Lists the ISO 3166-1 countries, by their name in the requested locale.",
        "description": "Lists active countries only; a retired country is still served by GET /countries/{countryCode}.",
        "operationId": "ListCountries",
        "parameters": [
          {
            "name": "locale",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageResponseOfCountryDto"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/geo/countries/{countryCode}": {
      "get": {
        "tags": [
          "geo"
        ],
        "summary": "Gets one ISO 3166-1 country by its alpha-2 code, with its name in the requested locale and its address format.",
        "description": "Serves retired countries too, codes ISO 3166-1 withdrew, with status retired, so a stored code still resolves; the country list shows active countries only.",
        "operationId": "GetCountry",
        "parameters": [
          {
            "name": "countryCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "locale",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CountryDetailDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/geo/countries/{countryCode}/subdivisions": {
      "get": {
        "tags": [
          "geo"
        ],
        "summary": "Lists the ISO 3166-2 subdivisions of a country, such as the Argentine provinces, by their name in the requested locale.",
        "operationId": "ListSubdivisions",
        "parameters": [
          {
            "name": "countryCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "locale",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageResponseOfSubdivisionDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/geo/cities": {
      "get": {
        "tags": [
          "geo"
        ],
        "summary": "Lists the cities (Georef localities), or autocompletes one from a typed query.",
        "description": "Without q, a cursor-paged list in name order. With q, an accent- and case-insensitive locality autocomplete from 2 characters: at most 10 results, ranked exact name, name prefix, a word in the name, words found in the province or country name, then similar spellings (from 3 characters); every word must appear in the locality or its province or country name, such as 'pilar cordoba' or 'villa maria cordoba'; no cursor, and limit is ignored. Clients should debounce keystrokes (about 250 ms).",
        "operationId": "ListCities",
        "parameters": [
          {
            "name": "countryCode",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "subdivisionCode",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          },
          {
            "name": "cursor",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "locale",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageResponseOfCityDto"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/geo/locales": {
      "get": {
        "tags": [
          "geo"
        ],
        "summary": "Lists the CLDR locales with modern coverage, by their name in the requested locale.",
        "operationId": "ListLocales",
        "parameters": [
          {
            "name": "locale",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageResponseOfLocaleDto"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/v1/geo/countries/{countryCode}/holidays": {
      "get": {
        "tags": [
          "geo"
        ],
        "summary": "Lists the public holidays of a country for one year (the current year in the country when absent): the national ones, plus those of one subdivision when asked.",
        "operationId": "ListHolidays",
        "parameters": [
          {
            "name": "countryCode",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "year",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "subdivisionCode",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "locale",
            "in": "query",
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageResponseOfHolidayDto"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Unprocessable Entity",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "AddressField": {
        "enum": [
          "street_line",
          "city",
          "subdivision",
          "postal_code"
        ],
        "type": "string",
        "description": "A part of an address that geo validates and a country may require."
      },
      "AddressFormatDto": {
        "required": [
          "postalCodePattern",
          "postalCodeExamples",
          "postalCodeRequired",
          "requiredFields",
          "subdivisionLabel"
        ],
        "type": "object",
        "properties": {
          "postalCodePattern": {
            "type": [
              "null",
              "string"
            ],
            "description": "The regular expression a whole postal code must match, or null when any code is accepted."
          },
          "postalCodeExamples": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "Valid postal codes, such as C1070AAM."
          },
          "postalCodeRequired": {
            "type": "boolean",
            "description": "Whether an address must carry a postal code."
          },
          "requiredFields": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AddressField"
            },
            "description": "The address parts the country requires, such as street_line and city."
          },
          "subdivisionLabel": {
            "description": "What the country calls its first-level subdivision, such as province.",
            "$ref": "#/components/schemas/SubdivisionLabel"
          }
        },
        "additionalProperties": false,
        "description": "A country's rules for capturing an address, after Google's libaddressinput metadata."
      },
      "CityDto": {
        "required": [
          "cityId",
          "name",
          "countryCode",
          "subdivisionCode",
          "subdivisionName",
          "label",
          "timeZoneId"
        ],
        "type": "object",
        "properties": {
          "cityId": {
            "description": "The city id other modules store.",
            "$ref": "#/components/schemas/CityId"
          },
          "name": {
            "type": "string",
            "description": "The official name, such as Pilar."
          },
          "countryCode": {
            "description": "The ISO 3166-1 alpha-2 code of its country.",
            "$ref": "#/components/schemas/CountryCode"
          },
          "subdivisionCode": {
            "description": "The ISO 3166-2 code of its province.",
            "$ref": "#/components/schemas/SubdivisionCode"
          },
          "subdivisionName": {
            "type": "string",
            "description": "The province name in the requested locale."
          },
          "label": {
            "type": "string",
            "description": "Name, province and country in the requested locale, such as Pilar, Buenos Aires, Argentina; with the department in\nparentheses after the name when another city of the province has the same name."
          },
          "timeZoneId": {
            "description": "The IANA zone of its province.",
            "$ref": "#/components/schemas/TimeZoneId"
          }
        },
        "additionalProperties": false,
        "description": "A city: a Georef locality with its official name and ready-made label."
      },
      "CityId": {
        "type": "string",
        "description": "The identifier of a geo city, the Georef locality other modules store a reference to.",
        "format": "uuid"
      },
      "CountryCode": {
        "pattern": "^[A-Z]{2}$",
        "type": "string",
        "description": "An ISO 3166-1 alpha-2 country code in upper case, such as `AR`."
      },
      "CountryDetailDto": {
        "required": [
          "countryCode",
          "alpha3",
          "numericCode",
          "name",
          "defaultCurrencyCode",
          "callingCode",
          "addressFormat",
          "status"
        ],
        "type": "object",
        "properties": {
          "countryCode": {
            "description": "The ISO 3166-1 alpha-2 code, such as AR.",
            "$ref": "#/components/schemas/CountryCode"
          },
          "alpha3": {
            "type": "string",
            "description": "The ISO 3166-1 alpha-3 code, such as ARG."
          },
          "numericCode": {
            "type": "string",
            "description": "The ISO 3166-1 three-digit numeric code, such as 032."
          },
          "name": {
            "type": "string",
            "description": "The name in the requested locale, or the nearest one along its fallback chain."
          },
          "defaultCurrencyCode": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "description": "The ISO 4217 code of the current tender, or null for a country without one.",
                "$ref": "#/components/schemas/CurrencyCode"
              }
            ],
            "description": "The ISO 4217 code of the current tender, or null for a country without one."
          },
          "callingCode": {
            "type": [
              "null",
              "string"
            ],
            "description": "The international calling code in digits without a plus sign, such as 54, or null when the country has none."
          },
          "addressFormat": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "description": "The rules for capturing an address in the country, or null when none is held, so any postal code is accepted.",
                "$ref": "#/components/schemas/AddressFormatDto"
              }
            ],
            "description": "The rules for capturing an address in the country, or null when none is held, so any postal code is accepted."
          },
          "status": {
            "description": "Active, or retired for a code ISO 3166-1 withdrew, which no list shows but stored references still resolve.",
            "$ref": "#/components/schemas/ReferenceStatus"
          }
        },
        "additionalProperties": false,
        "description": "An ISO 3166-1 country with its address format and status; a retired country is still served."
      },
      "CountryDto": {
        "required": [
          "countryCode",
          "alpha3",
          "numericCode",
          "name",
          "defaultCurrencyCode",
          "callingCode"
        ],
        "type": "object",
        "properties": {
          "countryCode": {
            "description": "The ISO 3166-1 alpha-2 code, such as AR.",
            "$ref": "#/components/schemas/CountryCode"
          },
          "alpha3": {
            "type": "string",
            "description": "The ISO 3166-1 alpha-3 code, such as ARG."
          },
          "numericCode": {
            "type": "string",
            "description": "The ISO 3166-1 three-digit numeric code, such as 032."
          },
          "name": {
            "type": "string",
            "description": "The name in the requested locale, or the nearest one along its fallback chain."
          },
          "defaultCurrencyCode": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "description": "The ISO 4217 code of the current tender, or null for a country without one.",
                "$ref": "#/components/schemas/CurrencyCode"
              }
            ],
            "description": "The ISO 4217 code of the current tender, or null for a country without one."
          },
          "callingCode": {
            "type": [
              "null",
              "string"
            ],
            "description": "The international calling code in digits without a plus sign, such as 54, or null when the country has none."
          }
        },
        "additionalProperties": false,
        "description": "An ISO 3166-1 country."
      },
      "CurrencyCode": {
        "pattern": "^[A-Z]{3}$",
        "type": "string",
        "description": "An ISO 4217 alphabetic currency code in upper case, such as `ARS`."
      },
      "CurrencyDto": {
        "required": [
          "currencyCode",
          "numericCode",
          "minorUnit",
          "name"
        ],
        "type": "object",
        "properties": {
          "currencyCode": {
            "description": "The ISO 4217 alphabetic code, such as ARS.",
            "$ref": "#/components/schemas/CurrencyCode"
          },
          "numericCode": {
            "type": [
              "null",
              "string"
            ],
            "description": "The ISO 4217 three-digit numeric code, such as 032, or null when ISO assigns none."
          },
          "minorUnit": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "description": "The decimal digits of an amount, 0 to 4, or null for a currency without a minor unit.",
                "$ref": "#/components/schemas/MinorUnit"
              }
            ],
            "description": "The decimal digits of an amount, 0 to 4, or null for a currency without a minor unit."
          },
          "name": {
            "type": "string",
            "description": "The name in the requested locale, or the nearest one along its fallback chain."
          }
        },
        "additionalProperties": false,
        "description": "An ISO 4217 currency in use."
      },
      "HolidayClass": {
        "enum": [
          "holiday",
          "non_working_day"
        ],
        "type": "string",
        "description": "Whether a public holiday is a paid day off or a day each employer decides to work."
      },
      "HolidayDto": {
        "required": [
          "date",
          "class",
          "origin",
          "subdivisionCode",
          "name"
        ],
        "type": "object",
        "properties": {
          "date": {
            "description": "The day, such as 2026-05-25.",
            "$ref": "#/components/schemas/LocalDate"
          },
          "class": {
            "description": "holiday (feriado) or non_working_day (día no laborable).",
            "$ref": "#/components/schemas/HolidayClass"
          },
          "origin": {
            "description": "fixed (inamovible), movable (trasladable), bridge (feriado puente) or decreed (a one-off day by decree).",
            "$ref": "#/components/schemas/HolidayOrigin"
          },
          "subdivisionCode": {
            "oneOf": [
              {
                "type": "null"
              },
              {
                "description": "The ISO 3166-2 subdivision it applies to, or null for a national holiday.",
                "$ref": "#/components/schemas/SubdivisionCode"
              }
            ],
            "description": "The ISO 3166-2 subdivision it applies to, or null for a national holiday."
          },
          "name": {
            "type": "string",
            "description": "The name in the requested locale, or the nearest one along its fallback chain."
          }
        },
        "additionalProperties": false,
        "description": "A public holiday."
      },
      "HolidayOrigin": {
        "enum": [
          "fixed",
          "movable",
          "bridge",
          "decreed"
        ],
        "type": "string",
        "description": "How a public holiday got its date."
      },
      "LocalDate": {
        "type": "string",
        "format": "date"
      },
      "Locale": {
        "type": "string",
        "description": "A BCP 47 language tag in canonical case, such as `es-AR` or `zh-Hant-TW`: language, optional script,\noptional region and variants; extensions and private use are not supported."
      },
      "LocaleDto": {
        "required": [
          "localeTag",
          "languageCode",
          "textDirection",
          "endonym",
          "name"
        ],
        "type": "object",
        "properties": {
          "localeTag": {
            "description": "The canonical BCP 47 tag, such as es-AR.",
            "$ref": "#/components/schemas/Locale"
          },
          "languageCode": {
            "description": "The primary language subtag, such as es.",
            "$ref": "#/components/schemas/Locale"
          },
          "textDirection": {
            "description": "The direction its script is written in.",
            "$ref": "#/components/schemas/TextDirection"
          },
          "endonym": {
            "type": "string",
            "description": "The locale's name in itself, such as español (Argentina)."
          },
          "name": {
            "type": "string",
            "description": "The locale's name in the requested locale, or the nearest one along its fallback chain."
          }
        },
        "additionalProperties": false,
        "description": "A CLDR locale with modern coverage, such as es-AR."
      },
      "MinorUnit": {
        "maximum": 4,
        "minimum": 0,
        "type": "integer",
        "description": "The number of decimal digits of a currency's minor unit, from 0 (CLP) to 4 (CLF)."
      },
      "PageResponseOfCityDto": {
        "required": [
          "items",
          "nextCursor"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CityDto"
            },
            "description": "The items of this page."
          },
          "nextCursor": {
            "type": [
              "null",
              "string"
            ],
            "description": "The cursor of the next page, or `null` on the last page."
          }
        },
        "additionalProperties": false,
        "description": "One page of a list."
      },
      "PageResponseOfCountryDto": {
        "required": [
          "items",
          "nextCursor"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CountryDto"
            },
            "description": "The items of this page."
          },
          "nextCursor": {
            "type": [
              "null",
              "string"
            ],
            "description": "The cursor of the next page, or `null` on the last page."
          }
        },
        "additionalProperties": false,
        "description": "One page of a list."
      },
      "PageResponseOfCurrencyDto": {
        "required": [
          "items",
          "nextCursor"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CurrencyDto"
            },
            "description": "The items of this page."
          },
          "nextCursor": {
            "type": [
              "null",
              "string"
            ],
            "description": "The cursor of the next page, or `null` on the last page."
          }
        },
        "additionalProperties": false,
        "description": "One page of a list."
      },
      "PageResponseOfHolidayDto": {
        "required": [
          "items",
          "nextCursor"
        ],
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/HolidayDto"
            },
            "description": "The items of this page."
          },
          "nextCursor": {
            "type": [
              "null",
              "string"
            ],
            "description": "The cursor of the next page, or `null` on the last page."
          }
        },
        "additionalProperties": false,
        "description": "One page of a list."
      },
