<?xml version="1.0" encoding="utf-8"?>
<!-- Packages come from nuget.org only: no machine-level feed leaks into a restore, and every package id is mapped to
     its one source, so a same-named package on another feed can never be picked (dependency confusion). -->
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
