# Environment variables for frappe-api.
#
# Copy to .env and adjust. .env is gitignored; never commit real secrets.
# Values below target a local run on the host (`task application:run`)
# against the compose services (`task database:up`, `task valkey:up`,
# `task observability:up`). Real secrets are injected with Infisical
# (`task secrets:run`).
#
# Commented-out variables show their default and are optional.
# Validation rules live in internal/foundation/configuration.

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# One of: development, staging, production. Required.
APPLICATION_ENVIRONMENT=development
# APPLICATION_NAME=frappe-api
# Per-hook Up/Down timeout. Must be >= HTTP_SHUTDOWN_DRAIN_DELAY + HTTP_SHUTDOWN_TIMEOUT.
# APPLICATION_HOOK_TIMEOUT=30s

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------

# One of: debug, info, warn, error.
LOGGING_LEVEL=debug

# ---------------------------------------------------------------------------
# HTTP server
# ---------------------------------------------------------------------------

# HTTP_PORT=8080
# HTTP_SHUTDOWN_TIMEOUT=10s
# Time the server keeps serving after readiness flips to 503 on shutdown.
# Should exceed load balancer deregistration; 0 is fine locally.
HTTP_SHUTDOWN_DRAIN_DELAY=0s
# HTTP_READ_HEADER_TIMEOUT=5s
# HTTP_READ_TIMEOUT=10s
# HTTP_WRITE_TIMEOUT=10s
# HTTP_IDLE_TIMEOUT=60s
# HTTP_MAX_HEADER_BYTES=1048576
# HTTP_MAX_BODY_BYTES=2097152
# Serves /docs, /openapi.json and /schemas. Set false in production.
# HTTP_DOCUMENTATION_ENABLED=true
# CIDRs allowed to set X-Forwarded-For (used for the rate limit key).
# HTTP_TRUSTED_PROXIES=
# Signs pagination cursors (HMAC-SHA256). Secret. At least 32 bytes, the same
# on every replica; required in staging and production. Empty in development
# uses a random per-process secret (cursors break on restart).
# Generate with: openssl rand -base64 48
# HTTP_CURSOR_SECRET=

# CORS: exact origins, comma-separated. Empty disables CORS entirely.
HTTP_CORS_ALLOWED_ORIGINS=http://localhost:3001
# HTTP_CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE
# HTTP_CORS_ALLOWED_HEADERS=Authorization,Content-Type,X-Request-ID
# HTTP_CORS_EXPOSED_HEADERS=X-Request-ID,RateLimit-Limit,RateLimit-Remaining,RateLimit-Reset,Retry-After
# Cannot be true together with a "*" origin.
# HTTP_CORS_ALLOW_CREDENTIALS=false
# HTTP_CORS_MAX_AGE=10m

# ---------------------------------------------------------------------------
# Internationalization
# ---------------------------------------------------------------------------

# BCP 47 locales the platform serves, comma-separated. Each needs an embedded
# catalog in internal/foundation/i18n/locales.
# I18N_SUPPORTED_LOCALES=es-419,en,pt-BR,fr,it,de,ru,zh-Hans,ko,ja
# Locale messages are authored in and the final fallback. Must be supported.
# I18N_SOURCE_LOCALE=es-419

# ---------------------------------------------------------------------------
# Health checks
# ---------------------------------------------------------------------------

# HEALTH_CHECK_INTERVAL=10s
# HEALTH_CHECK_TIMEOUT=2s
# HEALTH_FAILURE_THRESHOLD=3

# ---------------------------------------------------------------------------
# Database (Postgres). Secret.
# ---------------------------------------------------------------------------

# Application role (subject to RLS). Development-only credentials from
# deployments/database/initialize.sql.
DATABASE_URL=postgres://frappe_application:frappe_application_development_only@localhost:5432/frappe?sslmode=disable
# DATABASE_MAX_CONNECTIONS=10
# DATABASE_MIN_CONNECTIONS=2
# DATABASE_MAX_CONNECTION_LIFETIME=30m
# DATABASE_MAX_CONNECTION_IDLE_TIME=5m
# DATABASE_CONNECT_TIMEOUT=5s

# Migration role (schema owner). Used only by cmd/migrate (`task migrations:run`).
DATABASE_MIGRATION_URL=postgres://frappe_migration:frappe_migration_development_only@localhost:5432/frappe?sslmode=disable

# Outbox relay role (reads the outbox across tenants). Required when
# OUTBOX_ENABLED=true. Development-only credentials from initialize.sql.
DATABASE_OUTBOX_RELAY_URL=postgres://frappe_outbox_relay:frappe_outbox_relay_development_only@localhost:5432/frappe?sslmode=disable

# ---------------------------------------------------------------------------
# Events: broker (NATS JetStream)
# ---------------------------------------------------------------------------

# One of: none, memory, nats. OUTBOX_ENABLED=true requires a broker.
EVENTS_BROKER=nats
# Required when EVENTS_BROKER=nats.
NATS_URL=nats://localhost:4222
# Auth, mutually exclusive. Secrets.
# NATS_TOKEN=
# NATS_USER=
# NATS_PASSWORD=
# NATS_CREDENTIALS_FILE=
# Enables TLS.
# NATS_TLS_CERTIFICATE_AUTHORITY_FILE=
# NATS_CONNECT_TIMEOUT=
# NATS_ACK_WAIT=
# At most 5.
# NATS_STREAM_REPLICAS=
# NATS_STREAM_MAX_AGE=168h
# JetStream deduplication window for Nats-Msg-Id.
# NATS_STREAM_DUPLICATE_WINDOW=2m
# NATS_DEAD_LETTER_MAX_AGE=720h

# ---------------------------------------------------------------------------
# Events: consumer inbox (deduplicates deliveries per consumer)
# ---------------------------------------------------------------------------

# Used only while EVENTS_BROKER is not none. Retention must outlive every redelivery.
# INBOX_PURGE_INTERVAL=1h
# INBOX_RETENTION=168h

# ---------------------------------------------------------------------------
# Events: transactional outbox relay
# ---------------------------------------------------------------------------

# Publishes recorded events through EVENTS_BROKER. Requires EVENTS_BROKER
# other than none and DATABASE_OUTBOX_RELAY_URL. Events recorded while it is
# off stay in the outbox and are published once it is on.
OUTBOX_ENABLED=true
# OUTBOX_BATCH_SIZE=100
# OUTBOX_POLL_INTERVAL=1s
# Must exceed the time to publish one batch, or messages publish twice.
# OUTBOX_LEASE=30s
# OUTBOX_PURGE_INTERVAL=1h
# How long published messages are kept.
# OUTBOX_RETENTION=72h
# Retry delay doubles from BASE to MAX (MAX >= BASE).
# OUTBOX_BASE_BACKOFF=1s
# OUTBOX_MAX_BACKOFF=5m

# ---------------------------------------------------------------------------
# Jobs (River on the application database)
# ---------------------------------------------------------------------------

# Works jobs on this replica and joins the periodic leader election.
# Disabled replicas still enqueue; jobs wait in the database.
# JOBS_ENABLED=true
# Concurrent attempts per queue.
# JOBS_WORKERS=10
# Defaults for jobs whose definition sets none.
# JOBS_MAX_ATTEMPTS=25
# JOBS_JOB_TIMEOUT=1m
# JOBS_FETCH_POLL_INTERVAL=1s
# How long completed jobs are kept.
# JOBS_COMPLETED_RETENTION=24h
# How often queue depth and leadership gauges are sampled.
# JOBS_METRICS_INTERVAL=15s

# ---------------------------------------------------------------------------
# Machine translation (DeepL) and localized text sweeps
# ---------------------------------------------------------------------------

# Secret. Empty disables machine translation (reads fall back to the source).
# DEEPL_API_KEY=
# Empty picks the endpoint from the key (":fx" keys use the Free API).
# DEEPL_BASE_URL=https://api-free.deepl.com
# Target code for en: EN-US or EN-GB.
# DEEPL_ENGLISH_VARIANT=EN-US
# Empty, prefer_more or prefer_less.
# DEEPL_FORMALITY=
# DEEPL_TIMEOUT=30s
# Texts per job and request (1 to 50).
# DEEPL_BATCH_SIZE=50
# How long translation pauses after an exhausted quota or rejected key.
# DEEPL_QUOTA_PAUSE=1h
# How often lost translation requests are requested again.
# LOCALIZED_TEXTS_EXPIRED_SWEEP_INTERVAL=5m
# How often, and after how long, unreferenced texts are deleted.
# LOCALIZED_TEXTS_ORPHAN_SWEEP_INTERVAL=1h
# LOCALIZED_TEXTS_ORPHAN_MINIMUM_AGE=24h
# Rows one sweep handles per tenant.
# LOCALIZED_TEXTS_SWEEP_LIMIT=500
# How long an unleased pending translation waits before it is requested again.
# LOCALIZED_TEXTS_PENDING_TIMEOUT=15m
# Requests before a translation is marked failed.
# LOCALIZED_TEXTS_MAX_REQUEST_ATTEMPTS=5

# ---------------------------------------------------------------------------
# Rate limiting (Valkey)
# ---------------------------------------------------------------------------

# When false, Valkey is never contacted.
RATE_LIMIT_ENABLED=true
# RATE_LIMIT_REQUESTS=100
# RATE_LIMIT_WINDOW=1m
# Max latency an unhealthy Valkey can add before failing open.
# RATE_LIMIT_TIMEOUT=250ms

# Read-through cache (internal/foundation/cache). When false, every
# cache decorator loads from the source; nothing is stored.
CACHE_ENABLED=true
# memory (single process) or valkey (shared; requires VALKEY_ADDRESS).
CACHE_STORE=valkey
# Lifetime of entries created without one.
# CACHE_DEFAULT_TIME_TO_LIVE=5m
# Max latency an unhealthy store can add before a read fails open.
# CACHE_OPERATION_TIMEOUT=100ms

# Required when RATE_LIMIT_ENABLED=true or CACHE_STORE=valkey.
VALKEY_ADDRESS=localhost:6379
# Secret.
# VALKEY_PASSWORD=
# VALKEY_DATABASE=0
# VALKEY_DIAL_TIMEOUT=5s
# VALKEY_WRITE_TIMEOUT=5s

# ---------------------------------------------------------------------------
# Telemetry (OpenTelemetry)
# ---------------------------------------------------------------------------

# Set false to run without a collector (no OTLP export; console logs still work).
TELEMETRY_ENABLED=true
# Local otel-lgtm stack. For Grafana Cloud use its OTLP gateway endpoint.
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
# Grafana Cloud auth header. Secret.
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64 instance:token>
# Defaults to parentbased_traceidratio: 1.0 in development/staging, 0.1 in production.
# OTEL_TRACES_SAMPLER=parentbased_traceidratio
# OTEL_TRACES_SAMPLER_ARG=0.25
