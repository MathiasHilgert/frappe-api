<Project Sdk="Microsoft.NET.Sdk.Worker">
  <ItemGroup>
    <ProjectReference Include="../../Modules/Access/Frappe.Access/Frappe.Access.csproj" />
    <ProjectReference Include="../../Platform/Frappe.Caching/Frappe.Caching.csproj" />
    <ProjectReference Include="../../Platform/Frappe.Health/Frappe.Health.csproj" />
    <ProjectReference Include="../../Platform/Frappe.Modules/Frappe.Modules.csproj" />
    <ProjectReference Include="../../Platform/Frappe.Observability/Frappe.Observability.csproj" />
    <ProjectReference Include="../../Platform/Frappe.Observability.Hosting/Frappe.Observability.Hosting.csproj" />
    <ProjectReference Include="../../Platform/Frappe.Messaging/Frappe.Messaging.csproj" />
    <ProjectReference Include="../../Platform/Frappe.Scheduling/Frappe.Scheduling.csproj" />
    <ProjectReference Include="../../Modules/Identity/Frappe.Identity.Infrastructure/Frappe.Identity.Infrastructure.csproj" />
    <ProjectReference Include="../../Modules/Notifications/Frappe.Notifications.Infrastructure/Frappe.Notifications.Infrastructure.csproj" />
    <ProjectReference Include="../../Modules/Notifications/Channels/Frappe.Notifications.Channels.Email/Frappe.Notifications.Channels.Email.csproj" />
    <ProjectReference Include="../../Modules/Notifications/Kinds/Frappe.Notifications.Kinds.Account/Frappe.Notifications.Kinds.Account.csproj" />
    <ProjectReference Include="../../Modules/Notifications/Kinds/Frappe.Notifications.Kinds.Marketing/Frappe.Notifications.Kinds.Marketing.csproj" />
    <ProjectReference Include="../../Modules/Notifications/Producers/Frappe.Notifications.Producers.Identity/Frappe.Notifications.Producers.Identity.csproj" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" />
  </ItemGroup>
  <!-- A module's door brings its Http project, and with it the OpenAPI source generator of Frappe.Http (S1). The Worker serves no HTTP
       and writes no OpenAPI document: the generator stays out of its compilation, so the Worker's own code names no ASP.NET Core. -->
  <Target Name="RemoveOpenApiSourceGenerator" AfterTargets="ResolveLockFileAnalyzers">
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(Filename)' == 'Microsoft.AspNetCore.OpenApi.SourceGenerators'" />
    </ItemGroup>
  </Target>
</Project>
