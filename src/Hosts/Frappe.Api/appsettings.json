{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Http": {
    "OpenApi": {
      "Title": "Frappé API",
      "Version": "1.0.0",
      "Description": "The HTTP API of Frappé. Every endpoint lives under `/v1`; errors are RFC 9457 Problem Details."
    },
    "RateLimit": {
      "PermitLimit": 120,
      "Window": "00:01:00"
    }
  }
}
