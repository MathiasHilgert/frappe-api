<Project Sdk="Microsoft.NET.Sdk">
  <!-- The migrator: applies every context's migrations, then every module's seed, given a connection argument; never referenced by the host. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../Modules/Geo/Frappe.Geo.Infrastructure/Frappe.Geo.Infrastructure.csproj" />
    <ProjectReference Include="../Platform/Frappe.Platform.Modularity/Frappe.Platform.Modularity.csproj" />
    <ProjectReference Include="../Platform/Frappe.Platform.Persistence/Frappe.Platform.Persistence.csproj" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Frappe.Migrations.UnitTests" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="Sql/*.sql" LogicalName="%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
