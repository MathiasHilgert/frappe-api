<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Scalar.AspNetCore" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../Frappe.Kernel/Frappe.Kernel.csproj" />
    <ProjectReference Include="../Frappe.Platform.Modularity/Frappe.Platform.Modularity.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Using Include="ErrorOr" />
  </ItemGroup>
  <ItemGroup>
    <!-- Each assembly ships its error texts as errors.<locale>.json; ErrorTexts finds them by that name, so
         the locale in the file name must not turn them into satellite assemblies. -->
    <EmbeddedResource
      Include="Localization/errors.*.json"
      LogicalName="%(Filename)%(Extension)"
      WithCulture="false"
    />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Frappe.Platform.UnitTests" />
  </ItemGroup>
</Project>
