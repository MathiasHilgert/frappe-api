<html lang="@Document.Language.Value">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light dark">
<meta name="supported-color-schemes" content="light dark">
<title>@Document.Subject</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@@12..96,600&family=Hanken+Grotesk:wght@@400;500;600&display=swap">
<style>@((MarkupString)EmailStyles.Css)</style>
</head>
<body class="bg-ground" style="margin:0;padding:0;background:#f5f2f3;color:#1f1418;font-family:Hanken Grotesk,system-ui,-apple-system,Segoe UI,sans-serif;">
<div style="display:none;max-height:0;overflow:hidden;opacity:0;mso-hide:all;">@Document.Preheader</div>
<table role="presentation" class="bg-ground" width="100%" cellpadding="0" cellspacing="0" style="background:#f5f2f3;">
<tr><td align="center" style="padding:32px 16px;">
<table role="presentation" class="bg-surface" width="480" cellpadding="0" cellspacing="0" style="width:100%;max-width:480px;background:#ffffff;border-radius:18px;box-shadow:0 1px 2px rgba(61,12,28,0.05),0 12px 32px -16px rgba(61,12,28,0.16);">
<tr><td class="card" align="left" style="padding:40px 32px 8px 32px;text-align:left;">
<table role="presentation" width="100%" cellpadding="0" cellspacing="0">
<tr><td style="padding:0 0 24px 0;">
<img class="logo-light" src="cid:@EmailInlineImage.LightLogoId" width="56" height="56" alt="Frappé" style="display:block;width:56px;height:56px;border:0;">
<img class="logo-dark" src="cid:@EmailInlineImage.DarkLogoId" width="56" height="56" alt="Frappé" style="display:none;mso-hide:all;max-height:0;overflow:hidden;width:56px;height:56px;border:0;">
</td></tr>
@foreach (var block in Document.Blocks)
{
<tr><td style="padding:0 0 24px 0;"><BlockView Block="block" /></td></tr>
}
@if (Document.Unsubscribe is { } unsubscribe)
{
<tr><td style="padding:0 0 24px 0;"><p class="muted" style="margin:0;font-family:Hanken Grotesk,system-ui,-apple-system,Segoe UI,sans-serif;font-size:13px;line-height:18px;font-weight:400;color:#665860;">@unsubscribe.Text <a class="muted" href="@unsubscribe.Url.AbsoluteUri" style="color:#665860;text-decoration:underline;">@unsubscribe.LinkLabel</a></p></td></tr>
}
</table>
</td></tr>
</table>
</td></tr>
</table>
</body>
</html>

@code {
    [Parameter, EditorRequired]
    public EmailDocument Document { get; set; } = default!;
}
