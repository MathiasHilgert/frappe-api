<table role="presentation" cellpadding="0" cellspacing="0">
<tr><td class="btn" bgcolor="#6b1730" style="border-radius:999px;background:#6b1730;"><a class="btn-text" href="@Url.AbsoluteUri" style="display:inline-block;height:44px;line-height:44px;padding:0 24px;border-radius:999px;font-family:Hanken Grotesk,system-ui,-apple-system,Segoe UI,sans-serif;font-size:16px;font-weight:500;text-decoration:none;color:#ffffff;">@Label</a></td></tr>
</table>

@code {
    [Parameter, EditorRequired]
    public string Label { get; set; } = "";

    [Parameter, EditorRequired]
    public Uri Url { get; set; } = default!;
}
