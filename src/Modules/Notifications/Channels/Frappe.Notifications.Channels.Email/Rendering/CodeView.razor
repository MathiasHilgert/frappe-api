<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="width:100%;max-width:320px;table-layout:fixed;">
<tr>
@for (var index = 0; index < Value.Length; index++)
{
@if (index > 0)
{
<td width="8" style="width:8px;font-size:0;line-height:0;">&nbsp;</td>
}
<td class="box" align="center" style="height:56px;border:2px solid #1f1418;border-radius:10px;font-family:Hanken Grotesk,system-ui,-apple-system,Segoe UI,sans-serif;font-size:28px;line-height:32px;font-weight:600;font-variant-numeric:tabular-nums;text-align:center;color:#1f1418;">@Value[index]</td>
}
</tr>
</table>

@code {
    [Parameter, EditorRequired]
    public string Value { get; set; } = "";
}
