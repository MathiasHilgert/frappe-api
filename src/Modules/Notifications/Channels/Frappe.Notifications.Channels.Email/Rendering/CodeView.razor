<table role="presentation" align="center" cellpadding="0" cellspacing="0" style="border-collapse:separate;border-spacing:6px 0;margin:0 auto;">
<tr>
@foreach (var character in Value)
{
<td align="center" style="width:44px;height:56px;border:2px solid #000000;border-radius:8px;background:#ffffff;color:#000000;font-size:28px;font-weight:700;font-family:ui-monospace,SFMono-Regular,Menlo,Consolas,monospace;">@character</td>
}
</tr>
</table>

@code {
    [Parameter, EditorRequired]
    public string Value { get; set; } = "";
}
