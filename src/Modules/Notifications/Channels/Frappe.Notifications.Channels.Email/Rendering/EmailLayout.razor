<html lang="@Document.Language.Value">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light only">
<title>@Document.Subject</title>
</head>
<body style="margin:0;padding:0;background:#ffffff;color:#000000;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;">
<div style="display:none;max-height:0;overflow:hidden;opacity:0;color:#ffffff;">@Document.Preheader</div>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" style="background:#ffffff;">
<tr><td align="center" style="padding:32px 16px;">
<table role="presentation" width="480" cellpadding="0" cellspacing="0" style="width:100%;max-width:480px;">
<tr><td align="center" style="padding-bottom:24px;">
<div style="width:84px;height:84px;line-height:84px;border-radius:42px;background:#000000;color:#ffffff;font-size:40px;font-weight:700;text-align:center;">F</div>
</td></tr>
@foreach (var block in Document.Blocks)
{
<tr><td style="padding:0 0 16px 0;"><BlockView Block="block" /></td></tr>
}
@if (Document.Unsubscribe is { } unsubscribe)
{
<tr><td align="center" style="padding-top:16px;border-top:1px solid #000000;font-size:12px;line-height:18px;color:#000000;">
@unsubscribe.Text <a href="@unsubscribe.Url.AbsoluteUri" style="color:#000000;text-decoration:underline;">@unsubscribe.LinkLabel</a>
</td></tr>
}
</table>
</td></tr>
</table>
</body>
</html>

@code {
    [Parameter, EditorRequired]
    public EmailDocument Document { get; set; } = default!;
}
