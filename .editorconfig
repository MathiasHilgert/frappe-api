root = true

[*]
indent_style = space
indent_size = 4
insert_final_newline = true
charset = utf-8

[*.{json,yaml,yml,props,csproj,slnx}]
indent_size = 2

[*.cs]
# VB/F# interop naming concerns do not apply to this codebase.
dotnet_diagnostic.CA1716.severity = none
# ASP.NET Core has no SynchronizationContext.
dotnet_diagnostic.CA2007.severity = none
# Banned APIs are errors, not warnings.
dotnet_diagnostic.RS0030.severity = error

[tests/**/*.cs]
# Test names read as sentences: Method_Scenario_Expectation.
dotnet_diagnostic.CA1707.severity = none

[*.cs]
# Complexity gates are build errors (thresholds in eng/CodeMetricsConfig.txt and eng/SonarLint.xml).
dotnet_diagnostic.CA1502.severity = error
dotnet_diagnostic.CA1505.severity = error
dotnet_diagnostic.CA1506.severity = error
dotnet_diagnostic.S3776.severity = error
# Assembly marker types (e.g. IdentityContractsMarker) are intentionally empty classes.
dotnet_diagnostic.S2094.severity = none
# ASP.NET Core has no SynchronizationContext; mirrors CA2007 being off.
dotnet_diagnostic.MA0004.severity = none
# Duplicate of Sonar S1006 (override default values); Sonar owns it.
dotnet_diagnostic.MA0061.severity = none
# C# string == is already ordinal; the repo uses == for exact string matches.
dotnet_diagnostic.MA0006.severity = none

[tests/**/*.cs]
# Tests co-locate small test-only types (probe messages, fixture records) with the tests that use them.
dotnet_diagnostic.MA0048.severity = none

[src/Host/Frappe.Api/Internal/Generated/**.cs]
# Wolverine handler code written by `just codegen`: analyzers and `dotnet format` skip it.
generated_code = true

[tests/**/*.cs]
# Every async call in a test honours the test cancellation token (TestContext.Current.CancellationToken).
dotnet_diagnostic.xUnit1051.severity = error

[*.cs]
# Code style: the repo's dominant idioms, enforced in the build (EnforceCodeStyleInBuild) and by `dotnet format`.
csharp_style_namespace_declarations = file_scoped:error
dotnet_diagnostic.IDE0161.severity = error
# Braces only when the statement spans several lines: IDE0011 adds them there, RCS1002 removes them elsewhere.
csharp_prefer_braces = when_multiline:warning
dotnet_diagnostic.IDE0011.severity = warning
dotnet_diagnostic.RCS1002.severity = warning
csharp_style_var_for_built_in_types = true:warning
csharp_style_var_when_type_is_apparent = true:warning
csharp_style_var_elsewhere = true:warning
dotnet_diagnostic.IDE0007.severity = warning
dotnet_diagnostic.IDE0008.severity = none
# Unnecessary usings and formatting drift.
dotnet_diagnostic.IDE0005.severity = warning
dotnet_diagnostic.IDE0055.severity = warning
dotnet_sort_system_directives_first = true

# Naming: instance fields _camelCase, mutable static fields s_camelCase, constants and static readonly fields PascalCase.
dotnet_naming_symbols.constant_fields.applicable_kinds = field
dotnet_naming_symbols.constant_fields.required_modifiers = const
dotnet_naming_symbols.static_readonly_fields.applicable_kinds = field
dotnet_naming_symbols.static_readonly_fields.applicable_accessibilities = *
dotnet_naming_symbols.static_readonly_fields.required_modifiers = static, readonly
dotnet_naming_symbols.private_static_fields.applicable_kinds = field
dotnet_naming_symbols.private_static_fields.applicable_accessibilities = private, private_protected
dotnet_naming_symbols.private_static_fields.required_modifiers = static
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private, private_protected

dotnet_naming_style.pascal_case.capitalization = pascal_case
dotnet_naming_style.underscore_camel_case.capitalization = camel_case
dotnet_naming_style.underscore_camel_case.required_prefix = _
dotnet_naming_style.s_camel_case.capitalization = camel_case
dotnet_naming_style.s_camel_case.required_prefix = s_

dotnet_naming_rule.constant_fields_are_pascal_case.symbols = constant_fields
dotnet_naming_rule.constant_fields_are_pascal_case.style = pascal_case
dotnet_naming_rule.constant_fields_are_pascal_case.severity = warning
dotnet_naming_rule.static_readonly_fields_are_pascal_case.symbols = static_readonly_fields
dotnet_naming_rule.static_readonly_fields_are_pascal_case.style = pascal_case
dotnet_naming_rule.static_readonly_fields_are_pascal_case.severity = warning
dotnet_naming_rule.private_static_fields_are_s_camel_case.symbols = private_static_fields
dotnet_naming_rule.private_static_fields_are_s_camel_case.style = s_camel_case
dotnet_naming_rule.private_static_fields_are_s_camel_case.severity = warning
dotnet_naming_rule.private_fields_are_underscore_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_are_underscore_camel_case.style = underscore_camel_case
dotnet_naming_rule.private_fields_are_underscore_camel_case.severity = warning
dotnet_diagnostic.IDE1006.severity = warning
